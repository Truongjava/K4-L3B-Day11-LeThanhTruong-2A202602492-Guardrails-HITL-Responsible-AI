# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# =============================================================================
# BLUE (CP2–CP3) — gateway OpenAI-compatible
# Model Blue đọc từ OPENROUTER_MODEL; không khai thì fallback ds/deepseek-flash.
# =============================================================================
OPENROUTER_API_KEY=sk-...
OPENROUTER_BASE_URL=https://api.ai-box.vn/v1
OPENROUTER_MODEL=qwen3.7-flash

# =============================================================================
# RED + RED ADVANCE (CP4) — chọn MỘT provider (cùng key/model cho cả hai agent)
# Model lab mặc định (điểm bắt buộc CP4): gpt-4o-mini | gemini-3.5-flash
# Model khó (tuỳ chọn khi săn bonus):       gpt-5.6-luna | gemini-3.8-flash
# =============================================================================
RED_TEAM_PROVIDER=openai
# RED_TEAM_PROVIDER=gemini

# --- openai ---
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.ai-box.vn/v1   # chỉ cần khi đi qua gateway
OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-5.6-luna

# --- gemini ---
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# GOOGLE_GENAI_USE_VERTEXAI=0
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_MODEL=gemini-3.8-flash
